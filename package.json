{
  "name": "generator-magicdawn",
  "type": "module",
  "version": "0.25.1",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "description": "Yeoman generator for self use",
  "author": "magicdawn",
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/generator-magicdawn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicdawn/generator-magicdawn.git"
  },
  "bugs": {
    "url": "https://github.com/magicdawn/generator-magicdawn/issues"
  },
  "keywords": [
    "yeoman-generator"
  ],
  "main": "./generators/app/index.js",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "generators",
    "package.json",
    "templates"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -w --incremental",
    "build": "tsc",
    "test": "vitest run",
    "test:dev": "vitest",
    "test-cover": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "git-config": "^0.0.7",
    "liquidjs": "^10.30.1",
    "obug": "^3.0.0",
    "promise.ify": "^0.4.0",
    "yeoman-generator": "^10.3.0"
  },
  "devDependencies": {
    "@magicdawn/configs": "file:../@magicdawn__configs/",
    "@magicdawn/eslint-config": "^1.6.18",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/git-config": "^0.0.32",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-oxfmt": "^0.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "tsdown": "^0.23.7",
    "type-fest": "^5.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@beta",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yeoman-environment": "^8.5.1"
  },
  "lint-staged": {
    "*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "eslint --fix",
      "oxfmt --write"
    ],
    "!*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  }
}

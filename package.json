{
  "name": "generator-magicdawn",
  "type": "module",
  "version": "0.25.1",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "description": "Yeoman generator for self use",
  "author": "magicdawn",
  "license": "MIT",
  "homepage": "https://github.com/magicdawn/generator-magicdawn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicdawn/generator-magicdawn.git"
  },
  "bugs": {
    "url": "https://github.com/magicdawn/generator-magicdawn/issues"
  },
  "keywords": [
    "yeoman-generator"
  ],
  "main": "generators/app/index.js",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "generators",
    "package.json",
    "templates"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "tsc -w --incremental",
    "build": "rm -rf generators; tsc",
    "test": "vitest run",
    "test-cover": "vitest run --coverage",
    "prepublishOnly": "pnpm build",
    "test:dev": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
    "es-toolkit": "^1.45.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.4",
    "git-config": "^0.0.7",
    "globby": "^16.2.0",
    "json5": "^2.2.3",
    "liquidjs": "^10.25.5",
    "mem-fs": "^4.1.4",
    "moment": "^2.30.1",
    "p-props": "^6.1.0",
    "promise.ify": "^0.4.0",
    "umi-request": "^1.4.0",
    "yeoman-generator": "^8.1.2"
  },
  "devDependencies": {
    "@magicdawn/eslint-config": "^1.6.3",
    "@magicdawn/prettier-config": "^0.1.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/debug": "^4.1.13",
    "@types/eslint": "^9.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/git-config": "^0.0.32",
    "@types/node": "^25.6.0",
    "@types/swig": "^0.0.34",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsdown": "^0.21.8",
    "type-fest": "^5.5.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "yeoman-environment": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!*.{?(c|m)(j|t)s?(x),json,y?(a)ml}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
